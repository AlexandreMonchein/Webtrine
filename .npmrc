# Root eslint.config.mjs + config/eslint/*.mjs import these packages; they
# must be publicly hoisted to root node_modules (pnpm 10 removed the default
# eslint/prettier hoist patterns). Any NEW import in those config files whose
# package name matches neither pattern must get its own line here.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=globals
