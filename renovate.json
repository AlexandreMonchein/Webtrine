{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    "schedule:weekends"
  ],
  "timezone": "Europe/Paris",
  "automerge": false,
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 5,
  "rebaseWhen": "behind-base-branch"
}
