  "scripts": {
    "dev": "bash ./scripts/update-favicon.sh && VITE_CUSTOMER=${VITE_CUSTOMER:=showcase} vite",
    "dev:storybook": "VITE_CUSTOMER=${VITE_CUSTOMER:=showcase} storybook dev -p 6006",
    "build": "bash ./scripts/update-favicon.sh && VITE_CUSTOMER=${VITE_CUSTOMER:=showcase} ./scripts/build.sh",
    "build:storybook": "storybook build",
    "dev:serve": "VITE_CUSTOMER=${VITE_CUSTOMER:=showcase} ./scripts/serve.sh",
    "test": "VITE_CUSTOMER=${VITE_CUSTOMER:=showcase} vitest --config vitest.component.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:chillpaws": "TEST_CUSTOMER=chillpaws playwright test",
    "test:e2e:dipaolo": "TEST_CUSTOMER=dipaolo playwright test",
    "test:e2e:showcase": "TEST_CUSTOMER=showcase playwright test",
    "test:e2e:webtrine": "TEST_CUSTOMER=webtrine playwright test",
    "test:e2e:apt235": "TEST_CUSTOMER=apt235 playwright test",
    "test:e2e:all": "npm-run-all test:e2e:apt235 test:e2e:chillpaws test:e2e:dipaolo test:e2e:showcase test:e2e:webtrine",
    "test:e2e:all:update": "TEST_CUSTOMER=apt235 playwright test --update-snapshots && TEST_CUSTOMER=chillpaws playwright test --update-snapshots && TEST_CUSTOMER=dipaolo playwright test --update-snapshots && TEST_CUSTOMER=showcase playwright test --update-snapshots && TEST_CUSTOMER=webtrine playwright test --update-snapshots",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx",
    "convert:webp": "node ./scripts/convert-to-webp.js",
    "compress:images": "node ./scripts/compress-images.js",
    "analyze:unused": "knip"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest",
      "plugin:storybook/recommended"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
